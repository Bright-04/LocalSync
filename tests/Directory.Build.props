<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Test projects run JIT, so reflection-based tooling (Moq, assertion
         libraries) is fine here. The one exception is the AOT smoke test
         project, which sets IsAotCompatible back to true for itself. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CA1707: Method_Scenario_Expectation is the xUnit convention and reads
         far better in a test report than MethodScenarioExpectation. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      OPT-OUT, with an expiry date.

      This host still uses MVC controllers (AddControllers) and SignalR, both of
      which are AOT-hostile: MVC is flatly unsupported, and SignalR is only
      partially supported. Leaving IsAotCompatible on here would emit a flood of
      IL2xxx/IL3xxx which TreatWarningsAsErrors turns into a red build.

      Removed in Phase 1, when this project is split into LocalSync.Host
      (Minimal APIs + SSE) and LocalSync.Cli (PublishAot=true). At that point
      this line is deleted, not relaxed.
    -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalSync.Core\LocalSync.Core.csproj" />
    <ProjectReference Include="..\LocalSync.Infrastructure\LocalSync.Infrastructure.csproj" />
  </ItemGroup>

</Project>
